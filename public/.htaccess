Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Versioned asset names from asset(): site.bundle.v123456.css -> site.bundle.css
    RewriteRule ^(.+)\.v\d+\.(css|js|png|jpe?g|webp|gif|svg|ico|woff2?)$ $1.$2 [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Speed: compress text and let browsers cache versioned assets (?v=...) for a long time.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
# Set Cache-Control explicitly too: compressed (gzip/br) responses were going out as no-store.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2?)$">
        Header always set Cache-Control "public, max-age=31536000, immutable"
        Header always unset Expires
    </FilesMatch>
    <FilesMatch "\.(png|jpe?g|webp|gif|svg|ico)$">
        Header always set Cache-Control "public, max-age=2592000"
        Header always unset Expires
    </FilesMatch>
</IfModule>
